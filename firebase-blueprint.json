{
  "entities": {
    "registrations": {
      "title": "Campus Registrations",
      "description": "Student and faculty registration applications submitted on campus portal",
      "properties": {
        "id": { "type": "string", "description": "Unique registration ID" },
        "fullName": { "type": "string", "description": "Full name of applicant" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "description": "Requested role: student or faculty" },
        "department": { "type": "string", "description": "Department name" },
        "rollNumber": { "type": "string", "description": "Roll or register number" },
        "phone": { "type": "string", "description": "Phone number" },
        "status": { "type": "string", "description": "Status: pending, approved, or rejected" },
        "createdAt": { "type": "number", "description": "Creation timestamp in epoch ms" }
      },
      "required": ["fullName", "email", "role", "department", "status"]
    },
    "profiles": {
      "title": "User Profiles",
      "description": "Comprehensive profile records for campus members including basic info, contact details, blood group, address, etc.",
      "properties": {
        "id": { "type": "string", "description": "User ID matching auth/user identifier" },
        "userId": { "type": "string", "description": "Associated user ID" },
        "name": { "type": "string", "description": "Full name" },
        "firstName": { "type": "string", "description": "First name" },
        "lastName": { "type": "string", "description": "Last name" },
        "email": { "type": "string", "description": "Personal email" },
        "officialEmail": { "type": "string", "description": "Official institutional email" },
        "role": { "type": "string", "description": "User role" },
        "department": { "type": "string", "description": "Department name" },
        "programme": { "type": "string", "description": "Degree programme e.g. BE ECE" },
        "academicSession": { "type": "string", "description": "Academic session e.g. 2026-2027" },
        "semester": { "type": "number", "description": "Current semester number" },
        "className": { "type": "string", "description": "Class identifier e.g. II ECE" },
        "rollNumber": { "type": "string", "description": "Roll number" },
        "registerNo": { "type": "string", "description": "Anna University or campus register number" },
        "title": { "type": "string", "description": "Title e.g. Mr, Ms, Dr, Prof" },
        "dateOfBirth": { "type": "string", "description": "Date of birth string" },
        "gender": { "type": "string", "description": "Male, Female, or Others" },
        "phone": { "type": "string", "description": "Contact number" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp contact number" },
        "religion": { "type": "string", "description": "Religion" },
        "communalCategory": { "type": "string", "description": "Communal category e.g. MBC, BC, SC, ST, OC" },
        "bloodGroup": { "type": "string", "description": "Blood group e.g. O+VE" },
        "country": { "type": "string", "description": "Country of residence" },
        "state": { "type": "string", "description": "State" },
        "district": { "type": "string", "description": "District" },
        "cityVillage": { "type": "string", "description": "City or Village" },
        "address": { "type": "string", "description": "Full postal address" },
        "streetArea": { "type": "string", "description": "Street or area" },
        "pinCode": { "type": "string", "description": "Postal pincode" },
        "motherTongue": { "type": "string", "description": "Mother tongue language" },
        "nationality": { "type": "string", "description": "Nationality" },
        "updatedAt": { "type": "number", "description": "Last updated epoch timestamp" }
      },
      "required": ["userId", "name", "email", "role"]
    },
    "uploadable_contents": {
      "title": "Uploadable Contents & Documents",
      "description": "Cloud document uploads, learning materials, certificates, complaint evidence, assignment submissions, and project attachments",
      "properties": {
        "id": { "type": "string", "description": "Unique upload ID" },
        "title": { "type": "string", "description": "Title or display name of the uploaded document" },
        "fileName": { "type": "string", "description": "Original file name" },
        "fileType": { "type": "string", "description": "MIME type or file category e.g. PDF, image/png, docx" },
        "fileSize": { "type": "number", "description": "File size in bytes" },
        "fileUrl": { "type": "string", "description": "Download URL or base64 data URL" },
        "category": { "type": "string", "description": "Category: certificate, assignment, notes, complaint_attachment, project_doc, profile_avatar, lab_report" },
        "uploadedBy": { "type": "string", "description": "User ID of uploader" },
        "uploaderName": { "type": "string", "description": "Name of uploader" },
        "department": { "type": "string", "description": "Associated department" },
        "accessLevel": { "type": "string", "description": "Access visibility: public, department, private, admin_only" },
        "description": { "type": "string", "description": "Optional description or caption" },
        "createdAt": { "type": "number", "description": "Upload timestamp in epoch ms" }
      },
      "required": ["title", "fileName", "fileUrl", "category", "uploadedBy"]
    },
    "users": {
      "title": "Users",
      "description": "Campus system user accounts",
      "properties": {
        "id": { "type": "string", "description": "User ID" },
        "name": { "type": "string", "description": "User full name" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "description": "User role" },
        "department": { "type": "string", "description": "Department name" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "status": { "type": "string", "description": "Status: active or inactive" }
      },
      "required": ["name", "email", "role"]
    }
  }
}
