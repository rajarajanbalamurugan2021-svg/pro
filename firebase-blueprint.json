{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Campus system user accounts with authentication and profile DP avatar metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID" },
        "name": { "type": "string", "description": "User full name" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "description": "User role (student, faculty, hod, admin, super_admin)" },
        "department": { "type": "string", "description": "Department name" },
        "avatarUrl": { "type": "string", "description": "Profile DP / avatar image URL" },
        "status": { "type": "string", "description": "Status: active or inactive" },
        "updatedAt": { "type": "number", "description": "Timestamp in epoch ms" }
      },
      "required": ["name", "email", "role"]
    },
    "profiles": {
      "title": "User Profiles",
      "description": "Comprehensive profile records for campus members including avatar DP, contact details, blood group, address, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID matching auth/user identifier" },
        "userId": { "type": "string", "description": "Associated user ID" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Personal email" },
        "officialEmail": { "type": "string", "description": "Official institutional email" },
        "role": { "type": "string", "description": "User role" },
        "department": { "type": "string", "description": "Department name" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "programme": { "type": "string", "description": "Degree programme e.g. BE ECE" },
        "semester": { "type": "number", "description": "Current semester number" },
        "rollNumber": { "type": "string", "description": "Roll number" },
        "registerNo": { "type": "string", "description": "Anna University or campus register number" },
        "phone": { "type": "string", "description": "Contact number" },
        "bloodGroup": { "type": "string", "description": "Blood group" },
        "address": { "type": "string", "description": "Full postal address" },
        "bio": { "type": "string", "description": "Short bio or tagline" },
        "updatedAt": { "type": "number", "description": "Last updated epoch timestamp" }
      },
      "required": ["userId", "name", "email", "role"]
    },
    "registrations": {
      "title": "Campus Registrations",
      "description": "Student and faculty registration applications submitted on campus portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique registration ID" },
        "fullName": { "type": "string", "description": "Full name of applicant" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "description": "Requested role: student or faculty" },
        "department": { "type": "string", "description": "Department name" },
        "rollNumber": { "type": "string", "description": "Roll or register number" },
        "phone": { "type": "string", "description": "Phone number" },
        "status": { "type": "string", "description": "Status: pending, approved, or rejected" },
        "createdAt": { "type": "number", "description": "Creation timestamp in epoch ms" }
      },
      "required": ["fullName", "email", "role", "department", "status"]
    },
    "uploadable_contents": {
      "title": "Uploadable Contents & Documents",
      "description": "Cloud document uploads, learning materials, certificates, profile DP avatars, complaint evidence, assignment submissions, and project attachments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique upload ID" },
        "title": { "type": "string", "description": "Title or display name of the uploaded document" },
        "fileName": { "type": "string", "description": "Original file name" },
        "fileType": { "type": "string", "description": "MIME type or file category e.g. PDF, image/png, docx" },
        "fileSize": { "type": "number", "description": "File size in bytes" },
        "fileUrl": { "type": "string", "description": "Download URL or base64 data URL" },
        "category": { "type": "string", "description": "Category: profile_avatar, certificate, assignment, notes, complaint_attachment, project_doc, lab_report" },
        "uploadedBy": { "type": "string", "description": "User ID of uploader" },
        "uploaderName": { "type": "string", "description": "Name of uploader" },
        "department": { "type": "string", "description": "Associated department" },
        "accessLevel": { "type": "string", "description": "Access visibility: public, department, private, admin_only" },
        "createdAt": { "type": "number", "description": "Upload timestamp in epoch ms" }
      },
      "required": ["title", "fileName", "fileUrl", "category", "uploadedBy"]
    },
    "complaints": {
      "title": "Complaint Management",
      "description": "Student/Faculty campus grievances, maintenance issues, and AI auto-classified tickets",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Complaint ID" },
        "title": { "type": "string", "description": "Short complaint title" },
        "description": { "type": "string", "description": "Detailed description" },
        "category": { "type": "string", "description": "Category e.g. Infrastructure, Academic, Hostel" },
        "priority": { "type": "string", "description": "Priority: Low, Medium, High, Critical" },
        "status": { "type": "string", "description": "Status: OPEN, IN_PROGRESS, RESOLVED, CLOSED" },
        "submittedBy": { "type": "string", "description": "User ID or Name who filed complaint" },
        "assignedTo": { "type": "string", "description": "Assignee name or ID" },
        "department": { "type": "string", "description": "Target department" },
        "location": { "type": "string", "description": "Campus location" },
        "attachmentUrl": { "type": "string", "description": "Photo or document proof URL" },
        "createdAt": { "type": "number", "description": "Created timestamp epoch ms" },
        "updatedAt": { "type": "number", "description": "Updated timestamp epoch ms" }
      },
      "required": ["title", "description", "category", "status", "submittedBy"]
    },
    "leaveRequests": {
      "title": "Leave Management Requests",
      "description": "Student & Faculty leave applications, medical OD requests, and approval workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Leave request ID" },
        "studentId": { "type": "string", "description": "Applicant student or faculty ID" },
        "studentName": { "type": "string", "description": "Applicant full name" },
        "leaveType": { "type": "string", "description": "Leave type: Casual, Medical, On-Duty, Special" },
        "startDate": { "type": "string", "description": "Start date YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "End date YYYY-MM-DD" },
        "reason": { "type": "string", "description": "Reason for leave" },
        "status": { "type": "string", "description": "Status: PENDING, APPROVED, REJECTED, CANCELLED" },
        "approvedBy": { "type": "string", "description": "Approver name or ID" },
        "comments": { "type": "string", "description": "Approver comments" },
        "createdAt": { "type": "number", "description": "Created timestamp epoch ms" }
      },
      "required": ["studentId", "leaveType", "startDate", "endDate", "reason", "status"]
    },
    "student_results": {
      "title": "Result Portal Records",
      "description": "Semester academic results, CGPA, SGPA, subject grades, and arrear status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Result ID" },
        "studentId": { "type": "string", "description": "Student user ID" },
        "registerNo": { "type": "string", "description": "Student register number" },
        "studentName": { "type": "string", "description": "Student name" },
        "department": { "type": "string", "description": "Department name" },
        "semester": { "type": "number", "description": "Semester number" },
        "sgpa": { "type": "number", "description": "Semester SGPA" },
        "cgpa": { "type": "number", "description": "Cumulative CGPA" },
        "arrears": { "type": "number", "description": "Active arrear count" },
        "updatedAt": { "type": "number", "description": "Last updated epoch timestamp" }
      },
      "required": ["studentId", "registerNo", "semester", "cgpa"]
    },
    "communityPosts": {
      "title": "Community Posts & Discussions",
      "description": "Campus forum posts, research share, announcements, and student clubs feed",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Post ID" },
        "title": { "type": "string", "description": "Post title" },
        "content": { "type": "string", "description": "Post text body" },
        "authorId": { "type": "string", "description": "Author user ID" },
        "authorName": { "type": "string", "description": "Author name" },
        "authorAvatar": { "type": "string", "description": "Author profile DP" },
        "category": { "type": "string", "description": "Category e.g. Academic, General, Research, Event" },
        "likes": { "type": "number", "description": "Like count" },
        "createdAt": { "type": "number", "description": "Created timestamp epoch ms" }
      },
      "required": ["title", "content", "authorId", "category"]
    },
    "projects": {
      "title": "Project Innovation Hub",
      "description": "Student innovation projects, capstones, hackathon teams, and repositories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project ID" },
        "title": { "type": "string", "description": "Project title" },
        "description": { "type": "string", "description": "Project summary" },
        "department": { "type": "string", "description": "Department" },
        "createdById": { "type": "string", "description": "Creator user ID" },
        "creatorName": { "type": "string", "description": "Creator name" },
        "techStack": { "type": "string", "description": "Technologies used" },
        "status": { "type": "string", "description": "Status: IDEATION, IN_PROGRESS, COMPLETED, FEATURED" },
        "githubUrl": { "type": "string", "description": "GitHub repo link" },
        "createdAt": { "type": "number", "description": "Created timestamp epoch ms" }
      },
      "required": ["title", "description", "createdById", "status"]
    },
    "placements": {
      "title": "Placement & Internship Opportunities",
      "description": "Campus recruitment drives, company postings, eligibility criteria, and job offers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Opportunity ID" },
        "companyName": { "type": "string", "description": "Company name" },
        "roleTitle": { "type": "string", "description": "Job role title" },
        "type": { "type": "string", "description": "Drive type: Placement, Internship, Full-time" },
        "ctc": { "type": "string", "description": "CTC or stipend info" },
        "deadline": { "type": "string", "description": "Application deadline YYYY-MM-DD" },
        "description": { "type": "string", "description": "Drive description" },
        "createdAt": { "type": "number", "description": "Created timestamp epoch ms" }
      },
      "required": ["companyName", "roleTitle", "type", "deadline"]
    },
    "attendance": {
      "title": "Daily Attendance Records",
      "description": "Daily student subject attendance sessions logged by faculty",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Record ID" },
        "studentId": { "type": "string", "description": "Student user ID" },
        "studentName": { "type": "string", "description": "Student full name" },
        "department": { "type": "string", "description": "Department name" },
        "subjectId": { "type": "string", "description": "Subject ID" },
        "date": { "type": "string", "description": "Date string YYYY-MM-DD" },
        "period": { "type": "number", "description": "Period or hour number 1 to 8" },
        "status": { "type": "string", "description": "Attendance status: PRESENT, ABSENT, OD, or LEAVE" },
        "updatedAt": { "type": "number", "description": "Updated timestamp epoch ms" }
      },
      "required": ["studentId", "department", "subjectId", "date", "status"]
    },
    "audit_logs": {
      "title": "System Audit Logs",
      "description": "Audit trails for all administrative actions, profile changes, and module updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log ID" },
        "action": { "type": "string", "description": "Action name" },
        "performedBy": { "type": "string", "description": "User ID/Name who executed action" },
        "userRole": { "type": "string", "description": "Role of user" },
        "target": { "type": "string", "description": "Target module or document ID" },
        "timestamp": { "type": "string", "description": "ISO or formatted timestamp string" }
      },
      "required": ["action", "performedBy", "target"]
    },
    "conversations": {
      "title": "Student-Faculty Conversations",
      "description": "Direct communication threads between students and authorized faculty members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique conversation ID" },
        "studentId": { "type": "string", "description": "Student user ID" },
        "studentName": { "type": "string", "description": "Student full name" },
        "studentDepartment": { "type": "string", "description": "Student department name" },
        "studentRoll": { "type": "string", "description": "Student roll/register number" },
        "facultyId": { "type": "string", "description": "Faculty user ID" },
        "facultyName": { "type": "string", "description": "Faculty full name" },
        "facultyDepartment": { "type": "string", "description": "Faculty department name" },
        "subjectId": { "type": "string", "description": "Associated course or subject ID" },
        "subjectName": { "type": "string", "description": "Associated course or subject title" },
        "category": { "type": "string", "description": "Communication category e.g. Academic Doubt, Attendance, Internship" },
        "lastMessage": { "type": "string", "description": "Preview snippet of last message" },
        "lastMessageAt": { "type": "number", "description": "Epoch timestamp of last activity" },
        "unreadStudent": { "type": "number", "description": "Unread message count for student" },
        "unreadFaculty": { "type": "number", "description": "Unread message count for faculty" },
        "status": { "type": "string", "description": "Status: OPEN, RESOLVED, CLOSED, ARCHIVED" },
        "createdAt": { "type": "number", "description": "Created timestamp epoch ms" },
        "updatedAt": { "type": "number", "description": "Updated timestamp epoch ms" }
      },
      "required": ["studentId", "facultyId", "category", "status"]
    },
    "messages": {
      "title": "Conversation Chat Messages",
      "description": "Individual chat messages within a direct conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "conversationId": { "type": "string", "description": "Parent conversation ID" },
        "senderId": { "type": "string", "description": "Sender user ID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "senderRole": { "type": "string", "description": "Sender role: student or faculty" },
        "receiverId": { "type": "string", "description": "Recipient user ID" },
        "message": { "type": "string", "description": "Message text content" },
        "attachmentUrl": { "type": "string", "description": "URL of attached file" },
        "attachmentName": { "type": "string", "description": "File name of attachment" },
        "attachmentType": { "type": "string", "description": "MIME type or file extension" },
        "isRead": { "type": "boolean", "description": "Read status" },
        "isStarred": { "type": "boolean", "description": "Starred or pinned status" },
        "isEdited": { "type": "boolean", "description": "Edited status" },
        "createdAt": { "type": "number", "description": "Sent timestamp epoch ms" },
        "updatedAt": { "type": "number", "description": "Updated timestamp epoch ms" }
      },
      "required": ["conversationId", "senderId", "message"]
    },
    "academic_requests": {
      "title": "Structured Academic Requests",
      "description": "Formal requests submitted by students to faculty (doubt, attendance, GATE, career)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Request ID" },
        "studentId": { "type": "string", "description": "Student user ID" },
        "studentName": { "type": "string", "description": "Student full name" },
        "facultyId": { "type": "string", "description": "Faculty user ID" },
        "facultyName": { "type": "string", "description": "Faculty full name" },
        "category": { "type": "string", "description": "Request category" },
        "subject": { "type": "string", "description": "Subject title" },
        "topic": { "type": "string", "description": "Specific topic or question title" },
        "message": { "type": "string", "description": "Detailed question or query body" },
        "attachmentUrl": { "type": "string", "description": "Attachment URL" },
        "priority": { "type": "string", "description": "Priority: LOW, MEDIUM, HIGH, URGENT" },
        "status": { "type": "string", "description": "Status: OPEN, IN_PROGRESS, RESOLVED, CLOSED" },
        "createdAt": { "type": "number", "description": "Creation timestamp epoch ms" },
        "updatedAt": { "type": "number", "description": "Update timestamp epoch ms" }
      },
      "required": ["studentId", "facultyId", "category", "subject", "message", "status"]
    },
    "announcements": {
      "title": "Faculty Announcements",
      "description": "Faculty-to-student official announcements with class, subject, and department filtering",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Announcement ID" },
        "title": { "type": "string", "description": "Announcement title" },
        "message": { "type": "string", "description": "Announcement body content" },
        "facultyId": { "type": "string", "description": "Author faculty user ID" },
        "facultyName": { "type": "string", "description": "Author faculty name" },
        "department": { "type": "string", "description": "Target department name" },
        "year": { "type": "string", "description": "Target year e.g. 1st Year, 2nd Year, All" },
        "section": { "type": "string", "description": "Target section e.g. A, B, All" },
        "subject": { "type": "string", "description": "Target course/subject" },
        "priority": { "type": "string", "description": "Priority: Low, Medium, High, Urgent" },
        "attachmentUrl": { "type": "string", "description": "Attached file URL" },
        "attachmentName": { "type": "string", "description": "Attached file display name" },
        "publishDate": { "type": "string", "description": "Publication date string YYYY-MM-DD" },
        "expiryDate": { "type": "string", "description": "Expiry date string YYYY-MM-DD" },
        "createdAt": { "type": "number", "description": "Created timestamp epoch ms" }
      },
      "required": ["title", "message", "facultyId", "department", "publishDate"]
    },
    "communication_reports": {
      "title": "Communication Safety Reports",
      "description": "User reports for inappropriate content, spam, or misconduct in communication hub",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Report ID" },
        "conversationId": { "type": "string", "description": "Reported conversation ID" },
        "reportedBy": { "type": "string", "description": "User ID filing report" },
        "reporterName": { "type": "string", "description": "Name of user filing report" },
        "reportedUserId": { "type": "string", "description": "User ID being reported" },
        "reportedUserName": { "type": "string", "description": "Name of reported user" },
        "reason": { "type": "string", "description": "Reason category e.g. Inappropriate Language, Spam, Harassment" },
        "description": { "type": "string", "description": "Detailed explanation" },
        "status": { "type": "string", "description": "Status: OPEN, UNDER_REVIEW, RESOLVED, DISMISSED" },
        "createdAt": { "type": "number", "description": "Timestamp epoch ms" }
      },
      "required": ["conversationId", "reportedBy", "reportedUserId", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "System user profiles, account metadata, and profile DP images"
    },
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/profiles" },
      "description": "User academic and personal details, profile picture URL, and contact info"
    },
    "/registrations/{regId}": {
      "schema": { "$ref": "#/entities/registrations" },
      "description": "Student and faculty application registrations"
    },
    "/uploadable_contents/{uploadId}": {
      "schema": { "$ref": "#/entities/uploadable_contents" },
      "description": "Uploaded files, profile DP avatars, certificates, attachments"
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/complaints" },
      "description": "Campus complaints and maintenance grievance tickets"
    },
    "/leaveRequests/{leaveId}": {
      "schema": { "$ref": "#/entities/leaveRequests" },
      "description": "Student and faculty leave application requests"
    },
    "/student_results/{resultId}": {
      "schema": { "$ref": "#/entities/student_results" },
      "description": "Student academic results, semester CGPA, and SGPA"
    },
    "/communityPosts/{postId}": {
      "schema": { "$ref": "#/entities/communityPosts" },
      "description": "Community posts, discussions, and campus announcements"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/projects" },
      "description": "Student innovation projects and repositories"
    },
    "/placements/{placementId}": {
      "schema": { "$ref": "#/entities/placements" },
      "description": "Campus recruitment drives and internship opportunities"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/attendance" },
      "description": "Daily student attendance records"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/audit_logs" },
      "description": "System operational audit log records"
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/conversations" },
      "description": "Student-Faculty direct chat threads"
    },
    "/messages/{msgId}": {
      "schema": { "$ref": "#/entities/messages" },
      "description": "Individual chat messages within conversations"
    },
    "/academic_requests/{reqId}": {
      "schema": { "$ref": "#/entities/academic_requests" },
      "description": "Structured academic requests submitted by students to faculty"
    },
    "/announcements/{annId}": {
      "schema": { "$ref": "#/entities/announcements" },
      "description": "Faculty announcements targeting departments, classes, or subjects"
    },
    "/communication_reports/{repId}": {
      "schema": { "$ref": "#/entities/communication_reports" },
      "description": "Safety and misconduct reports filed for direct communications"
    }
  }
}
