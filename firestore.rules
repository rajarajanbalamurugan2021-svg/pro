rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' || 
        request.auth.token.role == 'SuperAdmin' ||
        getUserData().role == 'super_admin' || 
        getUserData().role == 'SuperAdmin'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'Admin' ||
        getUserData().role == 'admin' || 
        getUserData().role == 'Admin'
      );
    }

    function isFaculty() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'faculty' || 
        request.auth.token.role == 'Faculty' ||
        getUserData().role == 'faculty' || 
        getUserData().role == 'Faculty'
      );
    }

    function isHOD() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'hod' || 
        request.auth.token.role == 'HOD' ||
        getUserData().role == 'hod' || 
        getUserData().role == 'HOD'
      );
    }

    function isStudent() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Roles & Permissions Collections
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /permissions/{permId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Students, Faculty, Admins
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFaculty() || isOwner(studentId);
    }
    match /faculty/{facultyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Student Results & Marks & CGPA Collections
    match /student_results/{resultId} {
      allow read: if isSignedIn();
      allow create, update: if isFaculty();
      allow delete: if isAdmin();
    }
    match /marks/{markId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }
    match /cgpa/{cgpaId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // Attendance & Lab Records Collection
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFaculty();
    }
    match /labRecords/{labId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // Leave Requests & Policies Collections
    match /leaveRequests/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.studentId);
    }
    match /leave_requests/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.studentId);
    }
    match /leave_policies/{policyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Projects, Teams, Tasks Collection
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.createdById);
    }
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Community Posts, Comments, Messages, Notifications
    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Placement, Internships, Recommendations
    match /internships/{internshipId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /placements/{placementId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }
    match /careerRecommendations/{recId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Departments, Courses, Subjects
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // Documents, Reports, Analytics, Events, System Logs & Settings
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /analytics/{analyticsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }
    match /logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Single-document global sync collection fallback
    match /ckcet_campro/{docKey} {
      allow read, write: if true;
    }

    // Default Fallback Policy
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
