rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' || 
        request.auth.token.role == 'SuperAdmin' ||
        getUserData().role == 'super_admin' || 
        getUserData().role == 'SuperAdmin'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'Admin' ||
        getUserData().role == 'admin' || 
        getUserData().role == 'Admin'
      );
    }

    function isFaculty() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'faculty' || 
        request.auth.token.role == 'Faculty' ||
        getUserData().role == 'faculty' || 
        getUserData().role == 'Faculty'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || resource.data.userId == request.auth.uid);
    }

    // 1. Users & Profiles Collections (Supports Profile DP, Contact, Role & Avatar updates)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update, write: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /user_profiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 2. Registrations Collection
    match /registrations/{regId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 3. Uploadable Contents & File Attachments (Profile DPs, Certificates, Evidence photos)
    match /uploadable_contents/{uploadId} {
      allow read: if isSignedIn();
      allow create, update, write: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.uploadedBy);
    }
    match /uploads/{uploadId} {
      allow read: if isSignedIn();
      allow create, update, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 4. Student Results, Marks & CGPA Module
    match /student_results/{resultId} {
      allow read: if isSignedIn();
      allow create, update: if isFaculty() || isAdmin();
      allow delete: if isAdmin();
    }
    match /marks/{markId} {
      allow read: if isSignedIn();
      allow write: if isFaculty() || isAdmin();
    }
    match /cgpa/{cgpaId} {
      allow read: if isSignedIn();
      allow write: if isFaculty() || isAdmin();
    }

    // 5. Faculty & Lab Attendance Module
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFaculty() || isAdmin();
    }
    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFaculty() || isAdmin();
    }
    match /attendance_summary/{summaryId} {
      allow read: if isSignedIn();
      allow create, update, write: if isFaculty() || isAdmin();
    }
    match /attendance_audit/{auditId} {
      allow read: if isSignedIn();
      allow create, update, write: if isFaculty() || isAdmin();
    }
    match /labRecords/{labId} {
      allow read: if isSignedIn();
      allow write: if isFaculty() || isAdmin();
    }

    // 6. Leave Management Module
    match /leaveRequests/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.studentId);
    }
    match /leave_requests/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.studentId);
    }
    match /leave_policies/{policyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. Complaint Management Module
    match /complaints/{complaintId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // 8. Project Innovation & Team Collaboration Module
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.createdById);
    }
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 9. Community Forum, Discussions, Messages & Notifications
    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 10. Placement, Internships & Career Recommendations
    match /internships/{internshipId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /placements/{placementId} {
      allow read: if isSignedIn();
      allow write: if isFaculty() || isAdmin();
    }
    match /careerRecommendations/{recId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 11. Core Engineering CMS Tools & Resources
    match /core_cms_tools/{toolId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFaculty();
    }
    match /core_cms_branches/{branchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFaculty();
    }

    // 12. Departments & System Administration
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /logs/{logId} {
      allow read, write: if isSignedIn();
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 13. Universal Real-time Single-Document State Sync Fallback
    match /ckcet_campro/{docKey} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Default Fallback
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
