rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' || 
        request.auth.token.role == 'SuperAdmin' ||
        getUserData().role == 'super_admin' || 
        getUserData().role == 'SuperAdmin'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'Admin' ||
        getUserData().role == 'admin' || 
        getUserData().role == 'Admin'
      );
    }

    function isFaculty() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'faculty' || 
        request.auth.token.role == 'Faculty' ||
        getUserData().role == 'faculty' || 
        getUserData().role == 'Faculty'
      );
    }

    function isStudent() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Student Results Collection
    match /student_results/{resultId} {
      allow read: if isSignedIn() && (
        isFaculty() || 
        resource.data.studentId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
      allow create, update: if isFaculty();
      allow delete: if isAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        isFaculty() ||
        resource.data.studentId == request.auth.uid
      );
      allow create, update, delete: if isFaculty();
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (
        isFaculty() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isFaculty() ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Departments & Courses Collections
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isFaculty();
    }

    // Audit Logs Collection (SuperAdmin Only)
    match /audit_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Default Fallback Policy
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
